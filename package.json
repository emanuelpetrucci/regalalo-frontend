{
  "name": "regalalo-frontend",
  "version": "1.5.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "start:prod": "ng serve --port 4201 --configuration production",
    "start:bff": "ng serve --port 4201 --configuration production --proxy-config proxy.conf.json",
    "start:bff:dev": "ng serve --port 4201 --configuration development --proxy-config proxy.conf.json",
    "start:dev": "ng serve --port 4201 --configuration development",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:vercel": "node scripts/generate-vercel-environment.mjs && ng build --configuration vercel",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:pr": "playwright test --project=chromium",
    "test:e2e:ci": "playwright test --project=chromium --retries=2",
    "test:e2e:ci:nightly": "playwright test --retries=2",
    "test:e2e:flows": "playwright test e2e/tests/flows e2e/tests/timing",
    "test:e2e:flows:ui": "playwright test e2e/tests/flows e2e/tests/timing --ui",
    "test:e2e:critical": "playwright test e2e/tests/flows e2e/tests/timing e2e/tests/critical e2e/tests/contracts --project=chromium",
    "test:e2e:nightly": "playwright test e2e/tests/journeys --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "type-check": "ng build --configuration production --no-progress",
    "api:generate": "ng-openapi-gen -c openapi-ng.config.json",
    "sync:legal-i18n": "node scripts/sync-legal-i18n.mjs",
    "serve:ssr:regalalo": "node dist/regalalo/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.12",
    "@jsverse/transloco": "^8.3.0",
    "express": "^5.1.0",
    "ng-recaptcha-2": "^21.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.11.3",
    "@faker-js/faker": "^9.6.0",
    "@playwright/test": "^1.54.1",
    "@seontechnologies/playwright-utils": "latest",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.4.5",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "^1.0.5",
    "pg": "^8.21.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
